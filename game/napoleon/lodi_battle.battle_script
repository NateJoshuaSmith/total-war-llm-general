-- Lodi battle script. Pack path:
--   napoleon_historical_battles\lodi\lodi_battle.battle_script
-- A new seq in twllm_orders.txt moves one Austrian unit, or hands it back to
-- the game's AI. Every tick rewrites twllm_state.txt. TWLLM_TEST loads the
-- parser and returns before the game, the log, or any other file is touched.

local ORDERS_PATH = "twllm_orders.txt"
local STATE_PATH = "twllm_state.txt"
local LOG_PATH = "twllm_bridge_log.txt"
local MAX_ORDER_BYTES = 4096
local last_seq_text, tick_count, last_reason, last_tick_error = nil, 0, nil, nil
local shattered_logged = false
local controllers = {}

local function log(message)
  pcall(function()
    local handle = io.open(LOG_PATH, "a")
    handle:write(os.date("%H:%M:%S"), " ", tostring(message), "\n")
    handle:close()
  end)
end

local function try(obj, method, ...)
  local ok, result = pcall(function(...) return obj[method](obj, ...) end, ...)
  if ok then return result end
  return "ERR: " .. tostring(result)
end

local function finite_number(raw)
  local n = tonumber(raw)
  -- n - n is 0 for a real number, and not 0 for NaN or infinity.
  if n == nil or n - n ~= 0 then
    return nil
  end
  return n
end

function twllm_parse_orders(text)
  if type(text) ~= "string" then return nil, "not a string" end
  if #text > MAX_ORDER_BYTES then return nil, "too long" end

  local lines = {}
  local normalized = text:gsub("\r\n", "\n"):gsub("\r", "\n")
  for line in (normalized .. "\n"):gmatch("(.-)\n") do
    line = line:gsub("\r", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if line ~= "" then lines[#lines + 1] = line end
  end
  if #lines == 0 or lines[#lines] ~= "end" then return nil, "no end line" end

  local values = {}
  for i = 1, #lines - 1 do
    local key, value = lines[i]:match("^([%w_]+)=(.*)$")
    if not key then return nil, "bad line" end
    values[key] = value
  end
  local action = "move"
  if values.action ~= nil then
    action = values.action:match("^%s*(.-)%s*$")
  end
  if action ~= "move" and action ~= "release" then return nil, "bad action" end

  local parsed = {}
  local keys = { "seq", "unit" }
  if action == "move" then
    keys = { "seq", "unit", "x", "z", "run" }
  end
  for _, key in ipairs(keys) do
    if values[key] == nil then return nil, "missing " .. key end
    parsed[key] = finite_number(values[key])
    if parsed[key] == nil then return nil, "bad " .. key end
  end
  if parsed.seq % 1 ~= 0 or parsed.seq < 1 then return nil, "bad seq" end
  if parsed.unit % 1 ~= 0 or parsed.unit < 1 then return nil, "bad unit" end
  if action == "move" and parsed.run ~= 0 and parsed.run ~= 1 then return nil, "bad run" end
  local seq_text = values.seq:match("^%s*(.-)%s*$")
  local order = {
    seq = parsed.seq,
    seq_text = seq_text,
    unit = parsed.unit,
    action = action,
  }
  if action == "move" then
    order.x = parsed.x
    order.z = parsed.z
    order.run = (parsed.run == 1)
  end
  return order
end

local function call_failed(value)
  return type(value) == "string" and value:sub(1, 4) == "ERR:"
end

local function decimal_text(value)
  local n = finite_number(value)
  if n == nil then return "" end
  return string.format("%.1f", n)
end

local function whole_text(value)
  local n = finite_number(value)
  if n == nil then return "" end
  return string.format("%d", n)
end

local function flag_text(value)
  if value == true or value == 1 then return "1" end
  if value == false or value == 0 then return "0" end
  return ""
end

local function answered_yes(value)
  return value == true or value == 1
end

local function answered_no(value)
  return value == false or value == 0
end

local function unit_kind(unit)
  local cavalry = try(unit, "is_cavalry")
  if answered_yes(cavalry) then return "cav" end
  if not answered_no(cavalry) then return "" end
  local infantry = try(unit, "is_infantry")
  if answered_yes(infantry) then return "inf" end
  if not answered_no(infantry) then return "" end
  local artillery = try(unit, "is_artillery")
  if answered_yes(artillery) then return "art" end
  if not answered_no(artillery) then return "" end
  return "other"
end

function twllm_unit_line(alliance, army, index, unit)
  local x, z = "", ""
  local position = try(unit, "position")
  if not call_failed(position) and position ~= nil then
    x = decimal_text(try(position, "get_x"))
    z = decimal_text(try(position, "get_z"))
  end
  local shattered = try(unit, "is_shattered")
  local line = "u=" .. table.concat({
    tostring(alliance),
    tostring(army),
    tostring(index),
    x,
    z,
    whole_text(try(unit, "number_of_men_alive")),
    whole_text(try(unit, "initial_number_of_men")),
    decimal_text(try(unit, "bearing")),
    unit_kind(unit),
    flag_text(try(unit, "is_routing")),
    flag_text(shattered),
    whole_text(try(unit, "ammo_left")),
  }, ",")
  if call_failed(shattered) then return line, shattered end
  return line
end

local function read_orders()
  local handle = io.open(ORDERS_PATH, "r")
  if not handle then return nil end
  local text = handle:read(MAX_ORDER_BYTES)
  handle:close()
  return text or ""
end

local function write_state()
  local parts = { "tick=" .. tick_count, "last_seq=" .. (last_seq_text or "") }
  local alliances = battle:alliances()
  for alliance = 1, alliances:count() do
    local armies = alliances:item(alliance):armies()
    for army = 1, armies:count() do
      local units = armies:item(army):units()
      for index = 1, units:count() do
        local ok, unit = pcall(function() return units:item(index) end)
        if not ok then unit = nil end
        local line, shattered_err = twllm_unit_line(alliance, army, index, unit)
        if ok and shattered_err and not shattered_logged then
          shattered_logged = true
          log("is_shattered unavailable: " .. shattered_err)
        end
        parts[#parts + 1] = line
      end
    end
  end
  parts[#parts + 1] = "end"
  local handle = io.open(STATE_PATH, "w")
  if not handle then return end
  handle:write(table.concat(parts, "\n"), "\n")
  handle:close()
end

local function enemy_army()
  return battle:alliances():item(2):armies():item(1)
end

local function apply_order()
  local text = read_orders()
  if text == nil then return end
  local order, reason = twllm_parse_orders(text)
  if order == nil then
    if reason ~= last_reason then
      last_reason = reason
      log("orders rejected: " .. tostring(reason))
    end
    return
  end
  if order.seq_text == last_seq_text then return end

  -- Set first so a bad order, including an out-of-range unit, is not retried.
  last_seq_text = order.seq_text
  local units = enemy_army():units()
  local count = units:count()
  if order.unit > count then
    log("order seq=" .. order.seq_text .. " unit " .. order.unit
      .. " is out of range (" .. tostring(count) .. " units)")
    return
  end

  if order.action == "release" then
    local controller = controllers[order.unit]
    if controller == nil then
      log("unit " .. order.unit .. " not under our control")
      return
    end
    controller:release_control()
    controllers[order.unit] = nil
    log("released unit " .. order.unit)
    return
  end

  local unit = units:item(order.unit)
  local controller = controllers[order.unit]
  if controller == nil then
    controller = enemy_army():create_unit_controller()
    controller:add_units(unit)
    controller:take_control()
    controllers[order.unit] = controller
    log("took control of unit " .. order.unit)
  end
  local position = unit:position()
  local target = battle_vector:new()
  target:set(order.x, 0, order.z)
  log("order seq=" .. order.seq_text .. " unit " .. order.unit
    .. string.format(" at (%.1f, %.1f) -> (%.1f, %.1f) run=%s",
      position:get_x(), position:get_z(), order.x, order.z, tostring(order.run)))
  controller:goto_location(target, order.run)
end

local function log_tick_error(err)
  local text = tostring(err)
  if text == last_tick_error then return end
  last_tick_error = text
  log("tick ERR: " .. text)
end

function twllm_tick()
  tick_count = tick_count + 1
  local ok_order, err_order = pcall(apply_order)
  if not ok_order then log_tick_error(err_order) end
  local ok_state, err_state = pcall(write_state)
  if not ok_state then log_tick_error(err_state) end
end

local function note_baseline()
  local text = read_orders()
  if text == nil then
    log("no orders file at deploy")
    return
  end
  local order, reason = twllm_parse_orders(text)
  if order == nil then
    log("orders file at deploy did not parse: " .. tostring(reason))
    return
  end
  last_seq_text = order.seq_text
  log("baseline seq=" .. order.seq_text .. " (not acted on)")
end

function BattlePhaseChange(event)
  local name = tostring(try(event, "get_name"))
  log("phase: " .. name)
  if name ~= "Deployed" then return end
  local ok, err = pcall(note_baseline)
  if not ok then log("baseline ERR: " .. tostring(err)) end
  log("register_repeating_timer: " .. tostring(
    try(battle, "register_repeating_timer", "twllm_tick", 3000)))
end

if TWLLM_TEST then return end

log("lodi battle script loaded")
log("lua libs: math.floor=" .. type(math.floor)
  -- Startup log only. Any other math.huge in this file is a luacheck error.
  .. " math.huge=" .. type(math.huge) -- luacheck: ignore 143
  .. " string.gmatch=" .. type(string.gmatch)
  .. " string.match=" .. type(string.match)
  .. " string.gsub=" .. type(string.gsub)
  .. " string.format=" .. type(string.format)
  .. " table.concat=" .. type(table.concat)
  .. " os.date=" .. type(os.date)
  .. " io.open=" .. type(io.open))
battle = nil
local ok_battle, err_battle = pcall(function() battle = empire_battle:new() end)
log("empire_battle:new() ok=" .. tostring(ok_battle) .. " " .. tostring(err_battle or ""))
if ok_battle then
  log("register_battle_phase_handler: " .. tostring(
    try(battle, "register_battle_phase_handler", "BattlePhaseChange")))
end
